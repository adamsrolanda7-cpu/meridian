# Meridian — configuration du compte réel.
# Copier ce fichier vers .env, puis remplir les valeurs. .env est ignoré par git.
#
# IMPORTANT : une clé API présente ne suffit PAS à passer en réel.
# L'envoi d'ordres exige aussi `trade --execute --confirm` et
# MERIDIAN_LIVE_CONFIRM=YES. Sans cela, la commande reste en dry-run.

# Exchange ccxt : binance, kraken, okx, bybit, coinbase, ...
MERIDIAN_EXCHANGE_ID=binance

# Clé API : lecture + trading spot uniquement. Jamais de droit de retrait.
# Idéalement, restreindre la clé à une IP et à des montants faibles.
MERIDIAN_EXCHANGE_API_KEY=
MERIDIAN_EXCHANGE_API_SECRET=

# Phrase secrète uniquement pour certains exchanges (OKX, KuCoin, ...).
MERIDIAN_EXCHANGE_PASSPHRASE=

# true = testnet/sandbox (recommandé), false = mainnet.
# `--mainnet` sur la ligne de commande force le mainnet.
MERIDIAN_EXCHANGE_SANDBOX=true

# Devise de cotation du mandat.
MERIDIAN_QUOTE=USDT

# Double verrou humain : doit valoir YES pour que --execute envoie des ordres.
MERIDIAN_LIVE_CONFIRM=NO

# Garde-fous de taille. Le plafond par ordre évite un ordre géant par erreur.
MERIDIAN_MAX_ORDER_USD=250
MERIDIAN_MAX_DAILY_TURNOVER_USD=1000
